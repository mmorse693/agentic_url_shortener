# Copy to .env and adjust. .env is gitignored.

# Port the Express API listens on.
PORT=5000

# MongoDB connection string. Required outside NODE_ENV=test.
MONGODB_URI=mongodb://127.0.0.1:27017/url_shortener

# Public origin short links are built from, and the origin the self-referential
# check compares against. No trailing slash.
BASE_URL=http://localhost:3000

# Browser origin allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Number of proxy hops to trust for client IP resolution (0 = none).
# Set to 1 when running behind a single reverse proxy, so rate limiting sees
# the real client address instead of the proxy's.
TRUST_PROXY=0

# Rate limits.
RATE_LIMIT_CREATE_MAX=20
RATE_LIMIT_READ_MAX=100
